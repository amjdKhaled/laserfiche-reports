<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup><TargetFramework>net48</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable><AssemblyName>Reports.BA</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Mba.Core" Version="4.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <None Update="WixToolset.Mba.Host.config" CopyToOutputDirectory="Always" />
    <Compile Include="..\Reports.SafetyActions\InstallerFileSafety.cs" Link="InstallerFileSafety.cs" />
  </ItemGroup>
  <Target Name="CopyMbaNative" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)wixtoolset.mba.core/4.0.5/runtimes/win-x86/native/mbanative.dll" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
