{
  "Laserfiche": {
    "ServerUrl": "https://localhost",
    "RepositoryId": "YOUR_REPOSITORY_NAME",
    "ApiVersion": "Auto",
    "TimeoutSeconds": 45
  },
  "LocalAI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "YOUR_INSTALLED_CHAT_MODEL",
    "TimeoutSeconds": 600
  },
  "Reports": {
    "TimeZone": "Asia/Riyadh",
    "DateFormat": "MM/dd/yyyy",
    "QueryTimeoutSeconds": 120,
    "HealthTimeoutSeconds": 8,
    "MaxReportRows": 100000
  },
  "Features": {
    "EnableOcr": false,
    "EnableRag": false,
    "EnableVectorSearch": false,
    "EnableLegacyIndexing": false
  }
}
