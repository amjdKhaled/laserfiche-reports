{
  "Laserfiche": {
    "ServerUrl": "",
    "AuthenticationMode": "RepositoryPassword",
    "ApiBasePath": "/LFRepositoryAPI",
    "ApiVersion": "Auto",
    "RootEntryId": 0,
    "TimeoutSeconds": 120,
    "CredentialProvider": "Environment"
  },
  "Supabase": {
    "PostgresConnectionString": ""
  },
  "Ocr": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:8765",
    "TimeoutSeconds": 600,
    "MinimumTextLength": 3,
    "MaxImageSizeMegabytes": 50,
    "MaxFallbackPages": 100
  },
  "LocalAI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "",
    "EmbeddingModel": "nomic-embed-text-v2-moe",
    "EmbeddingDimensions": 768,
    "EmbeddingBatchSize": 16,
    "TimeoutSeconds": 120,
    "ChunkSize": 1200,
    "ChunkOverlap": 200,
    "DocumentEmbeddingPrefix": "search_document: ",
    "QueryEmbeddingPrefix": "search_query: "
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
