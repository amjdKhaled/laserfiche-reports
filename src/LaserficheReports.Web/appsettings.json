{
  "Laserfiche": {
    "ServerUrl": "",
    "AuthenticationMode": "RepositoryPassword",
    "ApiBasePath": "/LFRepositoryAPI",
    "ApiVersion": "Auto",
    "RootEntryId": 0,
    "TimeoutSeconds": 45,
    "CredentialProvider": "Environment"
  },
  "Supabase": {
    "PostgresConnectionString": ""
  },
  "Reports": {
    "EvidenceLimit": 24,
    "CandidateLimit": 240,
    "MaxLiveDocuments": 10000,
    "QueryTimeoutSeconds": 120,
    "HealthTimeoutSeconds": 8,
    "TimeZone": "Asia/Riyadh",
    "DateFormat": "MM/dd/yyyy",
    "MaxReportRows": 100000
  },
  "ReportsGraph": {
    "BaseUrl": "http://127.0.0.1:8766",
    "TimeoutSeconds": 14400
  },
  "Ocr": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:8765",
    "TimeoutSeconds": 1800,
    "MinimumTextLength": 3,
    "MaxImageSizeMegabytes": 50,
    "MaxFallbackPages": 100
  },
  "LocalAI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "",
    "OcrCorrectionEnabled": false,
    "OcrCorrectionModel": "qwen2.5vl:3b",
    "OcrCorrectionMaxTokens": 8192,
    "EmbeddingModel": "nomic-embed-text-v2-moe",
    "EmbeddingDimensions": 768,
    "EmbeddingBatchSize": 16,
    "TimeoutSeconds": 600,
    "ChunkSize": 1200,
    "ChunkOverlap": 80,
    "DocumentEmbeddingPrefix": "search_document: ",
    "QueryEmbeddingPrefix": "search_query: "
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Features": {
    "EnableOcr": false,
    "EnableRag": false,
    "EnableVectorSearch": false,
    "EnableLegacyIndexing": false
  }
